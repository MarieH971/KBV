{% extends 'base.html.twig' %}

{% block title %}Détails de l'Adhérent
{% endblock %}

{% block body %}
	<h1>Détails de l'adhérent
		{{ user.lastName }}
		{{ user.firstName }}</h1>

	<ul>
		<li>
			<strong>lastName :</strong>
			{{ user.lastName }}</li>
		<li>
			<strong>PrélastName :</strong>
			{{ user.firstName }}</li>
		<li>
			<strong>Email :</strong>
			{{ user.email }}</li>
		<li>
			<strong>Télételephone :</strong>
			{{ user.telephone }}</li>
		<li>
			<strong>Date de naissance :</strong>
			{{ user.dateDeNaissance ? user.dateDeNaissance|date('d/m/Y') : 'Non spécifiée' }}</li>
		<li>
			<strong>Date d'inscription :</strong>
			{{ user.registrationDate|date('d/m/Y') }}</li>
		<li>
			<strong>Date d'expiration de la licence :</strong>
			{{ user.dateExpirationLicence|date('d/m/Y') }}</li>
		<li>
			<strong>Level :</strong>
			{{ user.Level }}</li>
		<li>
			<strong>Rôle :</strong>
			{{ user.UserRole }}</li>
	</ul>

	<a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier</a>
	<a href="{{ path('app_user') }}" class="btn btn-secondary">Retour à la liste</a>
{% endblock %}